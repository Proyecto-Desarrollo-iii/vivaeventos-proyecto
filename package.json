{
  "name": "vivaeventos-proyecto",
  "version": "1.0.0",
  "description": "Frontend para VivaEventos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --coverage --runInBand"
  },
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "html5-qrcode": "^2.3.8",
    "jest": "^29.7.0",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
